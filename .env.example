# LocalCloud environment variables
#
# Every value here is optional. With an empty .env the lab runs with zero setup:
# browser localStorage for persistence and real-time simulation speed.

# Postgres connection for optional server-side lab persistence.
# When unset (or unreachable) the lab falls back to browser localStorage.
# This value stays on the server; it is never sent to the browser bundle.
# DATABASE_URL="postgresql://localcloud:localcloud_password@localhost:5432/localcloud_db?schema=public"

# Accepted but always ignored. The networking lab is simulation-only and never
# launches containers. Setting it to true prints a warning at startup.
ENABLE_DOCKER_BACKEND="false"

# Whether the simulated Cloud Shell terminal is available.
ENABLE_CLOUD_SHELL="true"

# Whether the guided lab and sample-network helpers are available.
ENABLE_LAB="true"

# Multiplier for every simulated lifecycle delay and packet-tracer hop.
# Higher is faster. Clamped to the 0.1 - 10 range.
SIMULATION_SPEED="1.0"

# Application URL, used for display only.
APP_URL="http://localhost:3000"

# Port the Express server listens on.
PORT="3000"

# Set to true to disable the Vite HMR websocket (useful in containers).
# DISABLE_HMR="false"